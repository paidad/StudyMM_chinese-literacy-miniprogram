.profile-page {
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  padding: 24rpx 32rpx 170rpx;
  background: #fffaf0;
  text-align: center;
}

.profile-title,
.stat-number,
.stat-label,
.lesson-label,
.lesson-value,
.warning-title,
.warning-text,
.profile-notice {
  display: block;
}

.profile-title {
  font-size: 48rpx;
  font-weight: bold;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.stat-card {
  width: 46%;
  margin: 7rpx 2%;
  padding: 16rpx 10rpx;
  box-sizing: border-box;
  border: 3rpx solid #7a5a35;
  border-radius: 22rpx;
  background: #ffffff;
}

.stat-number {
  font-size: 54rpx;
  font-weight: bold;
  line-height: 1.2;
}

.stat-label,
.lesson-label,
.warning-text,
.profile-notice {
  font-size: 34rpx;
  line-height: 1.5;
}

.lesson-box,
.warning-box {
  margin-top: 14rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.lesson-box {
  border: 3rpx solid #7a5a35;
}

.lesson-value {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: bold;
}

.warning-box {
  border: 3rpx solid #a64b32;
  text-align: left;
}

.warning-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #8b1e1e;
}

.warning-text {
  margin-top: 4rpx;
  color: #444444;
}

.profile-notice {
  min-height: 0;
  margin-top: 6rpx;
  color: #8b1e1e;
}
