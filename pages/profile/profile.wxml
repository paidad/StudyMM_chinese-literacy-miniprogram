<view class="profile-page">
  <view class="recorded-heading">
    <text class="profile-title">已录的字词（{{recordedCount}}）</text>
    <text wx:if="{{recordedCount || isOrganizing}}" class="organize-link" bindtap="onOrganizeTap">{{isOrganizing ? '取消' : '整理'}}</text>
  </view>

  <scroll-view class="recorded-scroll" scroll-y="true">
    <view wx:if="{{recordedCount}}" class="recorded-grid">
      <view wx:for="{{recordedItems}}" wx:key="char" class="recorded-card {{item.selected ? 'recorded-card-selected' : ''}}" data-char="{{item.char}}" bindtap="onRecordedTap" hover-class="recorded-card-pressed">
        <text class="recorded-pinyin">{{item.pinyin}}</text>
        <text class="recorded-character {{item.sizeClass}}">{{item.char}}</text>
        <text wx:if="{{isOrganizing}}" class="selection-mark">{{item.selected ? '✓' : '○'}}</text>
      </view>
    </view>
    <view wx:if="{{!recordedCount}}" class="recorded-empty">
      <text>还没有已学的录入字词</text>
    </view>
  </scroll-view>

  <view wx:if="{{isOrganizing}}" class="organize-actions">
    <button class="remove-selected-button" disabled="{{!selectedCount}}" bindtap="onRemoveSelectedTap">移出已录（{{selectedCount}}）</button>
  </view>
  <text class="profile-notice">{{notice}}</text>

  <view class="shared-nav">
    <view class="shared-nav-item" bindtap="onTodayTap" hover-class="shared-nav-pressed"><text class="shared-nav-mark">○</text><text class="shared-nav-label">今天</text></view>
    <view class="shared-nav-item" bindtap="onReviewTap" hover-class="shared-nav-pressed"><text class="shared-nav-mark">○</text><text class="shared-nav-label">复习</text></view>
    <view class="shared-nav-item shared-nav-current" bindtap="onProfileTap" hover-class="shared-nav-pressed"><text class="shared-nav-mark">●</text><text class="shared-nav-label">已录</text></view>
    <view class="shared-nav-item" bindtouchstart="onInputTouchStart" bindtouchend="onInputTouchEnd" bindtouchcancel="onInputTouchEnd" hover-class="shared-nav-pressed"><text class="shared-nav-mark">○</text><text class="shared-nav-label">录入</text></view>
  </view>
  <view wx:if="{{showInputCountdown}}" class="input-countdown-card">
    <text class="input-countdown-number">{{inputCountdown}}</text>
    <text class="input-countdown-help">继续按住</text>
  </view>
</view>
