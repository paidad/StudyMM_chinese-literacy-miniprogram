<view class="profile-page">
  <text class="profile-title">我的学习</text>

  <view class="stat-grid">
    <view class="stat-card"><text class="stat-number">{{knownCount}}</text><text class="stat-label">已认识字词</text></view>
    <view class="stat-card"><text class="stat-number">{{streak}}</text><text class="stat-label">连续学习天数</text></view>
    <view class="stat-card"><text class="stat-number">{{todayCount}}</text><text class="stat-label">今天安排数量</text></view>
    <view class="stat-card"><text class="stat-number">{{dueCount}}</text><text class="stat-label">到期复习数量</text></view>
  </view>

  <view class="lesson-box">
    <text class="lesson-label">当前课程</text>
    <text class="lesson-value">{{lessonText}}</text>
  </view>

  <view class="writing-mode-box">
    <text class="writing-mode-title">手写方式</text>
    <view class="writing-mode-switch">
      <view class="writing-mode-thumb {{writingMode === 'trace' ? 'writing-mode-thumb-right' : ''}}"></view>
      <button class="writing-mode-option {{writingMode === 'blank' ? 'writing-mode-selected' : ''}}" data-mode="blank" bindtap="onWritingModeTap" aria-label="空白田字格">空白</button>
      <button class="writing-mode-option {{writingMode === 'trace' ? 'writing-mode-selected' : ''}}" data-mode="trace" bindtap="onWritingModeTap" aria-label="临摹田字格">临摹</button>
    </view>
  </view>

  <view class="warning-box">
    <text class="warning-title">请家人留意</text>
    <text class="warning-text">学习记录和录音保存在这台手机里。换手机、清理微信缓存或卸载微信后，数据可能会丢失。</text>
  </view>

  <text class="profile-notice">{{notice}}</text>
  <view class="shared-nav">
    <view class="shared-nav-item" bindtap="onTodayTap" hover-class="shared-nav-pressed"><text class="shared-nav-mark">○</text><text class="shared-nav-label">今天</text></view>
    <view class="shared-nav-item" bindtap="onReviewTap" hover-class="shared-nav-pressed"><text class="shared-nav-mark">○</text><text class="shared-nav-label">复习</text></view>
    <view class="shared-nav-item shared-nav-current" bindtap="onProfileTap" hover-class="shared-nav-pressed"><text class="shared-nav-mark">●</text><text class="shared-nav-label">我的</text></view>
    <view class="shared-nav-item" bindtouchstart="onInputTouchStart" bindtouchend="onInputTouchEnd" bindtouchcancel="onInputTouchEnd" hover-class="shared-nav-pressed"><text class="shared-nav-mark">○</text><text class="shared-nav-label">录入</text></view>
  </view>
  <view wx:if="{{showInputCountdown}}" class="input-countdown-card">
    <text class="input-countdown-number">{{inputCountdown}}</text>
    <text class="input-countdown-help">继续按住</text>
  </view>
</view>
