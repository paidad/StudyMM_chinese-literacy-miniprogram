<view class="page">
  <view class="heading">
    <text class="greeting">今天学这个</text>
  </view>

  <scroll-view class="word-grid-scroll" scroll-y="true">
    <view wx:if="{{!isEmpty}}" class="word-grid">
      <view wx:for="{{todayItems}}" wx:key="id" class="word-card" data-index="{{item.index}}" bindtap="onWordTap" hover-class="word-card-pressed">
        <text class="pinyin">{{item.pinyin}}</text>
        <text class="character">{{item.char}}</text>
      </view>
    </view>

    <view wx:if="{{isEmpty}}" class="empty-card">
      <text class="empty-title">内置课程学完了</text>
      <text class="empty-help">可以请家人按住“录入”安排新内容</text>
    </view>
  </scroll-view>

  <view wx:if="{{showCustomCourseSwitch}}" class="custom-course-switch">
    <button class="lesson-nav-button custom-course-button" bindtap="onCustomCourseTap" hover-class="button-pressed">切换到录入课程</button>
  </view>
  <view wx:if="{{showLessonControls}}" class="lesson-nav">
    <button class="lesson-nav-button" bindtap="onPreviousLessonTap" hover-class="button-pressed"><text class="lesson-arrow">←</text><text>上一课</text></button>
    <button class="lesson-nav-button" bindtap="onNextLessonTap" hover-class="button-pressed"><text>下一课</text><text class="lesson-arrow lesson-arrow-right">→</text></button>
  </view>
  <view wx:if="{{showDefaultCourseSwitch}}" class="lesson-nav">
    <button class="lesson-nav-button default-course-button" bindtap="onDefaultCourseTap" hover-class="button-pressed"><text class="lesson-arrow">↩</text><text>切换到默认课程</text></button>
  </view>
  <button class="primary-button" bindtap="onStartTap" hover-class="button-pressed">开始学</button>
  <text class="notice">{{notice}}</text>
  <text class="storage-notice">{{storageNotice}}</text>

  <view class="bottom-nav">
    <view class="nav-item nav-item-current" bindtap="onTodayTap" hover-class="nav-item-pressed"><text class="nav-mark">●</text><text class="nav-label">今天</text></view>
    <view class="nav-item" bindtap="onReviewTap" hover-class="nav-item-pressed"><text class="nav-mark">○</text><text class="nav-label">复习</text></view>
    <view class="nav-item" bindtap="onProfileTap" hover-class="nav-item-pressed"><text class="nav-mark">○</text><text class="nav-label">我的</text></view>
    <view class="nav-item" bindtouchstart="onInputTouchStart" bindtouchend="onInputTouchEnd" bindtouchcancel="onInputTouchEnd" hover-class="nav-item-pressed"><text class="nav-mark">○</text><text class="nav-label">{{inputNavLabel}}</text></view>
  </view>

  <text class="input-hold-hint">长按录入 3 秒</text>

</view>
