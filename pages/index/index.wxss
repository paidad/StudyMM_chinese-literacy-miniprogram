.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  padding: 20rpx 30rpx 430rpx;
  background: #fffaf0;
  text-align: center;
}

.heading {
  padding: 0 0 14rpx;
}

.greeting {
  display: block;
  font-size: 46rpx;
  font-weight: bold;
  line-height: 1.4;
}

.notice,
.storage-notice {
  display: block;
  font-size: 36rpx;
  line-height: 1.5;
}

.word-grid-scroll {
  flex: 1;
  min-height: 0;
}

.word-grid {
  display: flex;
  justify-content: center;
  align-content: flex-start;
  flex-wrap: wrap;
  padding: 4rpx 0 16rpx;
}

.word-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 210rpx;
  height: 210rpx;
  margin: 9rpx;
  padding: 10rpx;
  box-sizing: border-box;
  border: 4rpx solid #222222;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 7rpx 0 #eadfca;
}

.empty-card {
  padding: 36rpx 20rpx;
  border: 4rpx solid #222222;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 7rpx 0 #eadfca;
}

.word-card-pressed,
.button-pressed,
.nav-item-pressed {
  opacity: 0.65;
}

.pinyin {
  display: block;
  width: 100%;
  overflow: hidden;
  font-size: 30rpx;
  line-height: 1.4;
  color: #555555;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.character {
  display: block;
  width: 100%;
  overflow: hidden;
  margin-top: 4rpx;
  font-size: 82rpx;
  font-weight: bold;
  line-height: 1.2;
  white-space: nowrap;
}

.empty-help {
  display: block;
  font-size: 32rpx;
  line-height: 1.5;
  color: #8a3b12;
}

.empty-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 48rpx;
  font-weight: bold;
}

.primary-button {
  position: fixed;
  z-index: 18;
  left: 30rpx;
  right: 30rpx;
  bottom: 170rpx;
  min-height: 120rpx;
  margin: 0;
  border-radius: 24rpx;
  font-size: 40rpx;
  font-weight: bold;
  line-height: 120rpx;
}

.lesson-nav {
  display: flex;
  position: fixed;
  z-index: 18;
  left: 30rpx;
  right: 30rpx;
  bottom: 310rpx;
  justify-content: space-between;
}

.custom-course-switch {
  position: fixed;
  z-index: 18;
  left: 30rpx;
  right: 30rpx;
  bottom: 430rpx;
}

.lesson-nav-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48.5%;
  min-height: 100rpx;
  margin: 0;
  border: 4rpx solid #6f2a09;
  border-radius: 22rpx;
  color: #6f2a09;
  background: #fffdf8;
  font-size: 34rpx;
  font-weight: bold;
  line-height: 1.2;
}

.default-course-button {
  width: 100%;
}

.custom-course-button {
  width: 100%;
}

.lesson-arrow {
  margin-right: 14rpx;
  font-size: 42rpx;
  line-height: 1;
}

.lesson-arrow-right {
  margin-right: 0;
  margin-left: 14rpx;
}

.primary-button {
  color: #ffffff;
  background: #a63e0c;
}

.primary-button::after {
  border: 0;
}

.notice {
  min-height: 0;
  margin-top: 6rpx;
  font-size: 30rpx;
  color: #6f2a09;
}

.storage-notice {
  color: #8b1e1e;
}

.bottom-nav {
  display: flex;
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  height: 108rpx;
  margin-top: 0;
  border-top: 2rpx solid #c9bda9;
  border-bottom: 2rpx solid #c9bda9;
  background: #ffffff;
}

.nav-item {
  flex: 1;
  min-height: 108rpx;
  padding: 14rpx 0 10rpx;
  box-sizing: border-box;
  color: #555555;
}

.nav-item-current {
  color: #8a330a;
  background: #f7ead5;
}

.nav-mark,
.nav-label {
  display: block;
}

.nav-mark {
  font-size: 30rpx;
  line-height: 1;
}

.nav-label {
  margin-top: 8rpx;
  font-size: 32rpx;
  line-height: 1.4;
}

.input-hold-hint {
  position: fixed;
  z-index: 19;
  right: 20rpx;
  bottom: 118rpx;
  font-size: 25rpx;
  line-height: 1.4;
  color: #8a6b52;
}
