<view class="input-page">
  <scroll-view class="input-scroll" scroll-y="true">
    <text class="input-title">家人录入</text>
    <text class="input-help">连着输入按单字拆开；用空格或逗号隔开，会按词保存。</text>

    <textarea class="raw-input" value="{{rawInput}}" bindinput="onRawInput" bindblur="onRawInput" placeholder="例如：河水湖海　或　医院 银行" maxlength="100"></textarea>
    <button class="add-button" bindtap="onAddLearningTap" catchtouchend="onAddLearningTouchEnd" hover-class="pressed">加入学习</button>

    <view class="today-box">
      <view class="today-heading">
        <text class="today-title">今天的字（{{todayCount}}个）</text>
        <text wx:if="{{hasTodayItems}}" class="clear-link" bindtap="onClearTodayTap">清空</text>
      </view>

      <view wx:if="{{hasTodayItems}}" class="today-list">
        <view wx:for="{{todayItems}}" wx:key="id" class="today-row">
          <view class="word-summary" data-char="{{item.char}}" bindtap="onTodayWordTap" hover-class="word-summary-pressed">
            <text class="today-char">{{item.char}}</text>
            <text class="today-pinyin">{{item.pinyin}}</text>
            <text class="speaker-mark">🔊</text>
          </view>
          <view class="row-actions">
            <button class="row-button record-row-button {{item.recordState}}" data-char="{{item.char}}" bindtap="onRecordRowTap" hover-class="pressed">{{item.recordLabel}}</button>
            <button class="row-button supplement-button {{item.supplementState}}" data-char="{{item.char}}" bindtap="onSupplementTap" hover-class="pressed">{{item.supplementLabel}}</button>
            <button class="row-button remove-button" data-char="{{item.char}}" bindtap="onRemoveTodayTap" hover-class="pressed">拿掉</button>
          </view>
        </view>
      </view>

      <text wx:if="{{!hasTodayItems}}" class="today-empty">还没有安排内容</text>
    </view>

    <text class="input-notice">{{notice}}</text>
    <button wx:if="{{showSettings}}" class="settings-button" bindtap="onOpenSettingTap" hover-class="pressed">打开麦克风权限</button>
  </scroll-view>

  <view class="bottom-nav">
    <view class="nav-item" bindtap="onTodayTap" hover-class="nav-pressed"><text class="nav-mark">○</text><text class="nav-label">今天</text></view>
    <view class="nav-item" bindtap="onReviewTap" hover-class="nav-pressed"><text class="nav-mark">○</text><text class="nav-label">复习</text></view>
    <view class="nav-item" bindtap="onProfileTap" hover-class="nav-pressed"><text class="nav-mark">○</text><text class="nav-label">我的</text></view>
    <view class="nav-item nav-current"><text class="nav-mark">●</text><text class="nav-label">录入</text></view>
  </view>

  <view wx:if="{{showSupplement}}" class="modal-mask" catchtouchmove="stopTouchMove">
    <view class="supplement-modal">
      <text class="modal-title">补充“{{supplementChar}}”</text>
      <text class="field-label">常用词</text>
      <input class="field-input" value="{{editWords}}" bindinput="onWordsInput" placeholder="例如：山上、高山"></input>
      <text class="field-label">例句</text>
      <input class="field-input" value="{{editSentence}}" bindinput="onSentenceInput" placeholder="例如：那边有座山。"></input>
      <text class="field-label">怎么记</text>
      <textarea class="tip-input" value="{{editTip}}" bindinput="onTipInput" placeholder="例如：三个山头。" maxlength="100"></textarea>
      <view class="modal-actions">
        <button class="modal-button cancel-button" bindtap="onCancelSupplement" hover-class="pressed">取消</button>
        <button class="modal-button save-button" bindtap="onSaveSupplement" hover-class="pressed">保存</button>
      </view>
    </view>
  </view>
</view>
