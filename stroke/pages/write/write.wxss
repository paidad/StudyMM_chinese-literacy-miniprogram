.write-page {
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  padding: 20rpx 28rpx 28rpx;
  background: #fffaf0;
  text-align: center;
}

.write-title,
.write-status {
  display: block;
}

.write-title {
  font-size: 48rpx;
  font-weight: bold;
}

.write-status {
  min-height: 54rpx;
  margin-top: 12rpx;
  font-size: 34rpx;
  line-height: 1.5;
  color: #6f2a09;
}

.reference-box {
  width: 600rpx;
  height: 600rpx;
  margin: 10rpx auto 0;
  border: 4rpx solid #333333;
  background: #ffffff;
  box-sizing: border-box;
}

.reference-canvas {
  width: 100%;
  height: 100%;
}

.reference-box-small {
  width: 210rpx;
  height: 210rpx;
}

.write-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 116rpx;
  margin-top: 12rpx;
  border-radius: 22rpx;
  font-size: 38rpx;
  font-weight: bold;
  line-height: 1.2;
}

.write-button-icon {
  display: inline-block;
  margin-right: 14rpx;
  font-size: 44rpx;
  font-weight: bold;
  line-height: 1;
}

.primary {
  color: #ffffff;
  background: #a63e0c;
}

.secondary {
  border: 4rpx solid #6f2a09;
  color: #6f2a09;
  background: #ffffff;
}

.trace-mode-button {
  border: 4rpx solid #39704d;
  color: #ffffff;
  background: #39704d;
}

.listen-button {
  border: 4rpx solid #6f2a09;
  color: #6f2a09;
  background: transparent;
}

.speaker-icon {
  display: block;
  font-size: 48rpx;
  line-height: 1;
}

.trace-box {
  width: 700rpx;
  height: 700rpx;
  margin: 10rpx auto 0;
  border: 4rpx solid #333333;
  box-sizing: border-box;
  background: #ffffff;
}

.trace-canvas {
  width: 100%;
  height: 100%;
}

.trace-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
}

.trace-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48.5%;
  min-height: 108rpx;
  margin: 0;
  border-radius: 22rpx;
  font-size: 36rpx;
  font-weight: bold;
  line-height: 1.2;
}

.trace-action-icon {
  display: inline-block;
  margin-right: 14rpx;
  font-size: 44rpx;
  font-weight: bold;
  line-height: 1;
}

.rewrite-icon {
  font-size: 48rpx;
}

.trace-listen-button {
  width: 100%;
}

.writing-mode-switch {
  display: flex;
  position: relative;
  width: 86%;
  height: 64rpx;
  margin: 24rpx auto 0;
  border: 2rpx solid #c9bda9;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fffdf9;
}

.writing-mode-thumb {
  position: absolute;
  top: 0;
  left: 0;
  width: 50%;
  height: 100%;
  border-radius: 14rpx;
  background: #f0e5d1;
  transition: transform 180ms ease;
}

.writing-mode-thumb-right {
  transform: translateX(100%);
}

.writing-mode-option {
  position: relative;
  z-index: 1;
  width: 50%;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  color: #765b42;
  background: transparent;
  font-size: 30rpx;
  line-height: 64rpx;
}

.writing-mode-option::after {
  border: 0;
}

.writing-mode-selected {
  font-weight: bold;
}

.erase-action {
  color: #ffffff;
  background: #b9472c;
}

.done-action {
  border: 4rpx solid #39704D;
  color: #ffffff;
  background: #39704D;
}

.pressed {
  opacity: 0.65;
}

button::after {
  border: 0;
}

@media screen and (max-height: 850px) {
  .write-page {
    padding-top: 12rpx;
    padding-bottom: 16rpx;
  }

  .write-title {
    font-size: 42rpx;
  }

  .write-status {
    min-height: 46rpx;
    margin-top: 6rpx;
    font-size: 30rpx;
  }

  .reference-box {
    width: 520rpx;
    height: 520rpx;
    margin-top: 6rpx;
  }

  .reference-box-small {
    width: 160rpx;
    height: 160rpx;
  }

  .trace-box {
    width: 520rpx;
    height: 520rpx;
    margin-top: 6rpx;
  }

  .write-button {
    min-height: 96rpx;
    margin-top: 8rpx;
  }

  .trace-actions {
    margin-top: 6rpx;
  }

  .trace-action {
    min-height: 88rpx;
  }

  .writing-mode-switch {
    height: 58rpx;
    margin-top: 16rpx;
  }

  .writing-mode-option {
    height: 58rpx;
    line-height: 58rpx;
  }
}
