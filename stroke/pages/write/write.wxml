<view class="write-page">
  <text class="write-status">{{status}}</text>

  <view class="reference-box {{showTrace ? 'reference-box-small' : ''}}">
    <canvas id="strokeCanvasView" canvas-id="strokeCanvas" class="reference-canvas" style="width: 100%; height: 100%;" bindtap="onReferenceTap"></canvas>
  </view>
  <button wx:if="{{!showTrace}}" class="write-button primary" bindtap="onReplayTap" hover-class="pressed"><text class="write-button-icon">↻</text><text>回放</text></button>
  <button wx:if="{{!showTrace}}" class="write-button trace-mode-button" bindtap="onTraceModeTap" hover-class="pressed"><text class="write-button-icon">✎</text><text>手写</text></button>
  <button wx:if="{{!showTrace}}" class="write-button listen-button" bindtap="onSpeakerTap" hover-class="pressed" aria-label="听发音"><text class="speaker-icon">🔊</text></button>
  <view class="trace-box" hidden="{{!showTrace}}">
    <canvas id="traceCanvasView" canvas-id="traceCanvas" class="trace-canvas" style="width: 100%; height: 100%;" disable-scroll="true" bindtouchstart="onTraceStart" bindtouchmove="onTraceMove" bindtouchend="onTraceEnd" bindtouchcancel="onTraceEnd"></canvas>
  </view>
  <view wx:if="{{showTrace}}" class="trace-actions">
    <button class="trace-action erase-action" bindtap="onEraseTap" hover-class="pressed"><text class="trace-action-icon rewrite-icon">↺</text><text>重写</text></button>
    <button class="trace-action done-action" bindtap="onDoneTap" hover-class="pressed"><text class="trace-action-icon">✓</text><text>下一个</text></button>
  </view>
  <button wx:if="{{showTrace}}" class="write-button listen-button trace-listen-button" bindtap="onSpeakerTap" hover-class="pressed" aria-label="听发音"><text class="speaker-icon">🔊</text></button>
  <view wx:if="{{showTrace}}" class="writing-mode-switch">
    <view class="writing-mode-thumb {{writingMode === 'trace' ? 'writing-mode-thumb-right' : ''}}"></view>
    <button class="writing-mode-option {{writingMode === 'blank' ? 'writing-mode-selected' : ''}}" data-mode="blank" bindtap="onWritingModeTap" aria-label="空白田字格">空白</button>
    <button class="writing-mode-option {{writingMode === 'trace' ? 'writing-mode-selected' : ''}}" data-mode="trace" bindtap="onWritingModeTap" aria-label="临摹田字格">临摹</button>
  </view>
</view>
